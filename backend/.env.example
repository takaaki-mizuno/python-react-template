ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app_test
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_ECHO=false
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=604800
AUTH_SESSION_IDLE_TTL_SECONDS=86400
# Touch authenticated sessions at most once per interval. Set 0 to touch every request.
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=300
# Local HTTP development must opt out explicitly. Production should omit this or set true.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_PREFIX=
# Trust only direct reverse proxies that are allowed to supply X-Forwarded-For.
# Values must be IP addresses or CIDR networks. Do not use 0.0.0.0/0 or ::/0.
AUTH_TRUSTED_PROXY_IPS=
# Argon2 m=64MiB with default 4 workers uses about 256MiB per process for password hashing.
AUTH_PASSWORD_HASH_CONCURRENCY=4
# In-memory rate limiting is best-effort for single-process local use.
# Replace it with a shared store before running multiple workers/instances.
# When bucket storage is full, new untracked buckets fail open and emit a warning.
AUTH_RATE_LIMIT_BACKEND=memory
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Failure buckets are recorded only after failed attempts.
# Duplicate register failures do not count toward the login-only email bucket.
AUTH_RATE_LIMIT_FAILURES_PER_EMAIL_IP=5
AUTH_RATE_LIMIT_FAILURES_PER_IP=20
AUTH_RATE_LIMIT_FAILURES_PER_EMAIL=20
# Successful account creation has a separate IP bucket: default 10 registrations/hour.
AUTH_RATE_LIMIT_REGISTRATIONS_PER_IP=10
AUTH_RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_MAX_BUCKETS_PER_SCOPE=10000
# Redis shared-store mode is opt-in. Keep URL empty unless AUTH_RATE_LIMIT_BACKEND=redis.
AUTH_RATE_LIMIT_REDIS_URL=
AUTH_RATE_LIMIT_REDIS_KEY_PREFIX=auth:rate_limit
AUTH_RATE_LIMIT_REDIS_UNAVAILABLE_POLICY=fail_closed
AUTH_RATE_LIMIT_REDIS_SOCKET_TIMEOUT_SECONDS=0.25
AUTH_RATE_LIMIT_REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=0.25
AUTH_RATE_LIMIT_REDIS_OPERATION_DEADLINE_SECONDS=0.8
AUTH_RATE_LIMIT_REDIS_CIRCUIT_BREAKER_FAILURES=5
AUTH_RATE_LIMIT_REDIS_CIRCUIT_BREAKER_COOLDOWN_SECONDS=10
AUTH_RATE_LIMIT_REDIS_MAX_CONNECTIONS=100
# Exact paths only. Keep empty unless the endpoint has another state validation.
AUTH_CSRF_EXEMPT_PATHS=

# OAuth/OIDC providers. Keep empty to disable OIDC login.
# Provider-specific keys use the uppercased provider id.
AUTH_OIDC_ENABLED_PROVIDERS=
AUTH_OIDC_REDIRECT_BASE_URL=http://localhost:8000
AUTH_OIDC_REAUTH_FRESHNESS_SECONDS=300
AUTH_OIDC_AUTHORIZATION_STARTS_PER_IP=20
AUTH_OIDC_STATE_TTL_SECONDS=300
# Example provider:
# AUTH_OIDC_ENABLED_PROVIDERS=google
# AUTH_OIDC_PROVIDER_GOOGLE_DISPLAY_NAME=Google
# AUTH_OIDC_PROVIDER_GOOGLE_ISSUER=https://accounts.google.com
# AUTH_OIDC_PROVIDER_GOOGLE_CLIENT_ID=
# AUTH_OIDC_PROVIDER_GOOGLE_CLIENT_SECRET=
# AUTH_OIDC_PROVIDER_GOOGLE_SCOPE=openid email profile
# AUTH_OIDC_PROVIDER_GOOGLE_TRUST_VERIFIED_EMAIL=false
# AUTH_OIDC_PROVIDER_GOOGLE_AUTO_PROVISION=link-only
# AUTH_OIDC_PROVIDER_GOOGLE_LINK_MODE=manual
# AUTH_OIDC_PROVIDER_GOOGLE_CALLBACK_PATH=/api/auth/oidc/google/callback
# AUTH_OIDC_PROVIDER_GOOGLE_CLAIMS_ALLOWLIST=
